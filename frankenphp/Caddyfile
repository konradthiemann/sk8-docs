# FrankenPHP configuration for sk8-docs (minimal variant of dunglas/symfony-docker).
# https://frankenphp.dev/docs/config · https://caddyserver.com/docs/caddyfile

{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

# Railway terminates TLS itself, so the site block only binds a port (SERVER_NAME=:8000).
{$SERVER_NAME::8000} {
	log {
		format json
	}

	root /app/public
	encode zstd br gzip

	# Compiled AssetMapper files carry a content hash in their name: cache them for a year.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
