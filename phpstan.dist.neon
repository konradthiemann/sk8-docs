parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        analyseAndScan:
            - tests/Fixtures
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
    treatPhpDocTypesAsCertain: false
